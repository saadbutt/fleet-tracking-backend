# Server Configuration
PORT=8080

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fleet_tracking?sslmode=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
# Matches the insecure dev-only fallback in internal/auth and
# docker-compose.yml, so it's explicit here rather than relied on. Never
# use this value past local dev.
JWT_SECRET=dev-only-insecure-secret-override-via-env

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
